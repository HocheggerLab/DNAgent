{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DNAagent CLI envelope 0.3.0",
  "description": "Runtime JSON responses only. CLI argument errors and GUI output are not covered. Coordinates are zero-based and half-open; relational bounds require domain validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "ok", "warnings"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "command": {"enum": ["inspect", "features", "primers", "sequence", "map", "enzymes", "sites"]},
    "ok": {"type": "boolean"},
    "warnings": {"$ref": "#/$defs/warnings"},
    "result": {},
    "error": {"$ref": "#/$defs/error"}
  },
  "oneOf": [
    {
      "required": ["result"],
      "not": {"required": ["error"]},
      "properties": {"ok": {"const": true}},
      "oneOf": [
        {"properties": {"command": {"const": "inspect"}, "result": {"$ref": "#/$defs/inspect"}}},
        {"properties": {"command": {"const": "features"}, "result": {"type": "array", "items": {"$ref": "#/$defs/feature"}}}},
        {"properties": {"command": {"const": "primers"}, "result": {"type": "array", "items": {"$ref": "#/$defs/primer"}}}},
        {"properties": {"command": {"const": "sequence"}, "result": {"$ref": "#/$defs/sequence"}}},
        {"properties": {"command": {"const": "map"}, "result": {"$ref": "#/$defs/map"}}},
        {"properties": {"command": {"const": "enzymes"}, "result": {"type": "array", "items": {"$ref": "#/$defs/enzyme"}}}},
        {"properties": {"command": {"const": "sites"}, "result": {"$ref": "#/$defs/restriction_scan"}}}
      ]
    },
    {"required": ["error"], "not": {"required": ["result"]}, "properties": {"ok": {"const": false}}}
  ],
  "$defs": {
    "position": {"type": "integer", "minimum": 0},
    "strand": {"enum": ["forward", "reverse", "unknown"]},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
    "warning": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "packet_type"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "packet_type": {"type": ["integer", "null"], "minimum": 0, "maximum": 255}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {"code": {"enum": ["command_failed", "import_warnings", "restriction_scan_failed"]}, "message": {"type": "string"}}
    },
    "inspect": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "length", "topology", "feature_count", "primer_count", "warnings"],
      "properties": {
        "name": {"type": "string"}, "length": {"type": "integer", "minimum": 1},
        "topology": {"enum": ["linear", "circular"]},
        "feature_count": {"$ref": "#/$defs/position"}, "primer_count": {"$ref": "#/$defs/position"},
        "warnings": {"$ref": "#/$defs/warnings"}
      }
    },
    "region": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "start", "end"],
          "properties": {"kind": {"const": "linear"}, "start": {"$ref": "#/$defs/position"}, "end": {"type": "integer", "minimum": 1}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "start", "length"],
          "properties": {"kind": {"const": "circular_arc"}, "start": {"$ref": "#/$defs/position"}, "length": {"type": "integer", "minimum": 1}}
        }
      ]
    },
    "location": {
      "type": "object", "additionalProperties": false, "required": ["parts", "strand", "operator"],
      "properties": {
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/region"}},
        "strand": {"$ref": "#/$defs/strand"}, "operator": {"enum": ["contiguous", "join", "order"]}
      },
      "oneOf": [
        {"properties": {"operator": {"const": "contiguous"}, "parts": {"maxItems": 1}}},
        {"properties": {"operator": {"enum": ["join", "order"]}, "parts": {"minItems": 2}}}
      ]
    },
    "qualifier": {
      "type": "object", "additionalProperties": false, "required": ["key", "value"],
      "properties": {"key": {"type": "string"}, "value": {"type": ["string", "null"]}}
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "kind", "strand", "location", "color", "qualifiers"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "label": {"type": "string"}, "kind": {"type": "string"},
        "strand": {"$ref": "#/$defs/strand"}, "location": {"$ref": "#/$defs/location"},
        "color": {"type": ["string", "null"]},
        "qualifiers": {"type": "array", "items": {"$ref": "#/$defs/qualifier"}}
      }
    },
    "primer": {
      "type": "object", "additionalProperties": false, "required": ["name", "sequence", "description"],
      "properties": {
        "name": {"type": "string"}, "sequence": {"type": "string", "pattern": "^[ACGTRYSWKMBDHVN]+$"},
        "description": {"type": ["string", "null"]}
      }
    },
    "sequence": {
      "type": "object", "additionalProperties": false, "required": ["start", "end", "sequence"],
      "properties": {
        "start": {"$ref": "#/$defs/position"}, "end": {"$ref": "#/$defs/position"},
        "sequence": {"type": "string", "pattern": "^[ACGTRYSWKMBDHVN]*$"}
      }
    },
    "enzyme": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "recognition_sequence", "top_cut_offset", "bottom_cut_offset"],
      "properties": {
        "name": {"enum": ["EcoRI", "BamHI", "EcoRV", "KpnI", "BsaI", "BsmBI"]},
        "recognition_sequence": {"type": "string", "pattern": "^[ACGT]+$"},
        "top_cut_offset": {"type": "integer"}, "bottom_cut_offset": {"type": "integer"}
      }
    },
    "restriction_site": {
      "type": "object", "additionalProperties": false,
      "required": ["enzyme", "recognition", "strand", "top_cut", "bottom_cut", "cleavage_available", "overhang_polarity", "overhang_length"],
      "properties": {
        "enzyme": {"type": "string"}, "recognition": {"$ref": "#/$defs/region"},
        "strand": {"enum": ["forward", "reverse"]},
        "top_cut": {"type": ["integer", "null"], "minimum": 0},
        "bottom_cut": {"type": ["integer", "null"], "minimum": 0},
        "cleavage_available": {"type": "boolean"},
        "overhang_polarity": {"enum": ["blunt", "five_prime", "three_prime"]},
        "overhang_length": {"$ref": "#/$defs/position"}
      }
    },
    "restriction_scan": {
      "type": "object", "additionalProperties": false,
      "required": ["length", "topology", "enzymes", "sites", "assumptions"],
      "properties": {
        "length": {"type": "integer", "minimum": 1},
        "topology": {"enum": ["linear", "circular"]},
        "enzymes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/enzyme"}},
        "sites": {"type": "array", "items": {"$ref": "#/$defs/restriction_site"}},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "map": {
      "type": "object", "additionalProperties": false, "required": ["output_path"],
      "properties": {"output_path": {"type": "string"}}
    }
  }
}
