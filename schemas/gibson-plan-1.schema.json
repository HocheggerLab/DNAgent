{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DNAagent PCR-tail Gibson plan 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inputs",
    "cores",
    "topology",
    "overlap_length",
    "annealing_length"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1,
      "maxItems": 16
    },
    "cores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "start",
          "length",
          "orientation"
        ],
        "properties": {
          "input": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999
          },
          "length": {
            "type": "integer",
            "minimum": 36,
            "maximum": 1000000
          },
          "orientation": {
            "enum": [
              "forward",
              "reverse"
            ]
          }
        }
      },
      "minItems": 1,
      "maxItems": 128
    },
    "topology": {
      "enum": [
        "linear",
        "circular"
      ]
    },
    "overlap_length": {
      "type": "integer",
      "minimum": 20,
      "maximum": 60
    },
    "annealing_length": {
      "type": "integer",
      "minimum": 18,
      "maximum": 40
    }
  }
}
