{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DNAgent PCR-tail Gibson plan 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inputs",
    "cores",
    "topology",
    "overlap_length",
    "annealing_length"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "inputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sequence",
              "topology"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sequence": {
                "type": "string",
                "pattern": "^[ACGTRYSWKMBDHVNacgtryswkmbdhvn]+$",
                "minLength": 1,
                "maxLength": 1000000
              },
              "topology": {
                "enum": [
                  "linear",
                  "circular"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "enzymes",
              "fragment_id"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "enzymes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "fragment_id": {
                "type": "string",
                "minLength": 1
              },
              "strand": {
                "enum": [
                  "top",
                  "bottom"
                ]
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 16
    },
    "cores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "start",
          "length",
          "orientation",
          "preparation"
        ],
        "properties": {
          "input": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999
          },
          "length": {
            "type": "integer",
            "minimum": 36,
            "maximum": 1000000
          },
          "orientation": {
            "enum": [
              "forward",
              "reverse"
            ]
          },
          "preparation": {
            "enum": [
              "pcr",
              "provided"
            ],
            "description": "How this fragment reaches the reaction. 'provided' (restriction digest, synthesis, stock linear DNA) is used as given and receives no primers; its junction overlaps are written into the neighbouring amplified fragments' primers. Required: an omission must not silently amplify a vector you intend to digest."
          }
        }
      },
      "minItems": 1,
      "maxItems": 128
    },
    "topology": {
      "enum": [
        "linear",
        "circular"
      ]
    },
    "overlap_length": {
      "type": "integer",
      "minimum": 20,
      "maximum": 60
    },
    "annealing_length": {
      "type": "integer",
      "minimum": 18,
      "maximum": 40
    }
  }
}
