{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "primer-design-plan-1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inputs",
    "request"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "feature_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_input",
        "window_start",
        "window_length",
        "junction_min_bases",
        "positive_inputs",
        "negative_inputs",
        "min_product_length",
        "max_product_length",
        "screen_max_product_length",
        "max_mismatches",
        "exact_three_prime_bases",
        "max_results",
        "constraints"
      ],
      "properties": {
        "reference_input": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "window_start": {
          "type": "integer",
          "minimum": 0
        },
        "window_length": {
          "type": "integer",
          "minimum": 36,
          "maximum": 500
        },
        "junction_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "junction_min_bases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "positive_inputs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        },
        "negative_inputs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        },
        "min_product_length": {
          "type": "integer",
          "minimum": 36,
          "maximum": 500
        },
        "max_product_length": {
          "type": "integer",
          "minimum": 36,
          "maximum": 500
        },
        "screen_max_product_length": {
          "type": "integer",
          "minimum": 36,
          "maximum": 5000
        },
        "max_mismatches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "exact_three_prime_bases": {
          "type": "integer",
          "minimum": 4,
          "maximum": 40
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_length",
            "max_length",
            "min_tm_c",
            "max_tm_c",
            "target_tm_c",
            "max_pair_tm_difference_c",
            "min_gc_fraction",
            "max_gc_fraction",
            "max_hairpin_stem",
            "max_dimer_run",
            "max_three_prime_run",
            "solution"
          ],
          "properties": {
            "min_length": {
              "type": "integer",
              "minimum": 18,
              "maximum": 40
            },
            "max_length": {
              "type": "integer",
              "minimum": 18,
              "maximum": 40
            },
            "min_tm_c": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "max_tm_c": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "target_tm_c": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "max_pair_tm_difference_c": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "min_gc_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_gc_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_hairpin_stem": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "max_dimer_run": {
              "type": "integer",
              "minimum": 0,
              "maximum": 40
            },
            "max_three_prime_run": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "solution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sodium_mm",
                "potassium_mm",
                "tris_mm",
                "magnesium_mm",
                "dntp_mm",
                "primer_nm"
              ],
              "properties": {
                "sodium_mm": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 500
                },
                "potassium_mm": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 500
                },
                "tris_mm": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 200
                },
                "magnesium_mm": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "dntp_mm": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "primer_nm": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5000
                }
              }
            }
          }
        }
      }
    }
  }
}
