{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DNAagent Prototype",
  "version": "0.1.0",
  "identifier": "org.dnagent.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "DNAagent Prototype", "width": 1200, "height": 850 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:" }
  },
  "bundle": { "active": false }
}
