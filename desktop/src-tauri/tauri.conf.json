{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DNAgent",
  "version": "0.2.0",
  "identifier": "uk.ac.sussex.hochegger.dnagent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DNAgent",
        "width": 1200,
        "height": 850
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "DNA design and cloning workbench",
    "longDescription": "An agent-friendly DNA design and cloning workbench: plasmid maps, sequence views, restriction digests and Gibson assembly on one Rust engine, shared with the dnagent CLI.",
    "copyright": "Copyright (c) Hochegger Lab",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
