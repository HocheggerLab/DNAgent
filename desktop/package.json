{
  "name": "dnagent-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test src/*.test.ts e2e/lib/*.test.ts",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "e2e": "node e2e/check-prod-bundle.ts && cargo build -q -p dnagent-cli --locked --manifest-path ../Cargo.toml && playwright test",
    "e2e:headed": "cargo build -q -p dnagent-cli --locked --manifest-path ../Cargo.toml && playwright test --headed",
    "e2e:check-prod": "node e2e/check-prod-bundle.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.3",
    "ajv": "^8.20.0",
    "typescript": "^5.9",
    "vite": "^7"
  }
}
