{
  "$schema": "../scenario.schema.json",
  "id": "gibson-agent-cdna-into-vector",
  "description": "Agent round trip: mark the cDNA ORF, hand off, the agent (real CLI) designs the Gibson and writes the annotated product into the workspace, and the product opens with the features, primers and length the CLI reports",
  "fixture": "fixtures/formats/snapgene/pUC19_M77789.dna",
  "steps": [
    {
      "set_viewport": {
        "width": 1440,
        "height": 900
      }
    },
    {
      "set_workspace": "desktop/e2e/artifacts/gibson-agent-cdna-into-vector/workspace"
    },
    {
      "open": {}
    },
    {
      "open": {
        "fixture": "fixtures/formats/genbank/synthetic_cdna.gb"
      }
    },
    {
      "select_feature": {
        "label": "synthetic ORF"
      },
      "note": "the part to clone"
    },
    {
      "click": {
        "testid": "handoff"
      }
    },
    {
      "expect": [
        {
          "state": "workspace.handoff.open",
          "equals": true
        },
        {
          "state": "tab_count",
          "equals": 2
        }
      ]
    },
    {
      "run_cli": {
        "args": [
          "gibson",
          "fixtures/plans/synthetic-cdna-into-puc19.json",
          "--out",
          "desktop/e2e/artifacts/gibson-agent-cdna-into-vector/workspace/pUC19_synthetic_ORF.gb",
          "--output",
          "json"
        ]
      },
      "note": "the agent: CDS of the cDNA into the pUC19 polylinker"
    },
    {
      "poll_workspace": true
    },
    {
      "expect": [
        {
          "state": "workspace.notices[*].kind",
          "equals": [
            "new"
          ]
        }
      ]
    },
    {
      "click": {
        "testid": "notice-open"
      }
    },
    {
      "expect": [
        {
          "state": "tab_count",
          "equals": 3
        },
        {
          "state": "document.length",
          "equals_cli": {
            "command": "inspect",
            "file": "desktop/e2e/artifacts/gibson-agent-cdna-into-vector/workspace/pUC19_synthetic_ORF.gb",
            "path": "result.length"
          }
        },
        {
          "state": "features[*].name",
          "equals_cli": {
            "command": "features",
            "file": "desktop/e2e/artifacts/gibson-agent-cdna-into-vector/workspace/pUC19_synthetic_ORF.gb",
            "path": "result[*].label"
          },
          "message": "carried features, primer sites and overlaps"
        },
        {
          "state": "primers.count",
          "equals_cli": {
            "command": "primers",
            "file": "desktop/e2e/artifacts/gibson-agent-cdna-into-vector/workspace/pUC19_synthetic_ORF.gb",
            "path": "result",
            "transform": "count"
          },
          "message": "the designed oligos"
        },
        {
          "state": "map.drawn_ids",
          "equals_cli": {
            "command": "features",
            "file": "desktop/e2e/artifacts/gibson-agent-cdna-into-vector/workspace/pUC19_synthetic_ORF.gb",
            "path": "result[*].id"
          }
        },
        {
          "state": "map.accounted_ids",
          "equals_cli": {
            "command": "features",
            "file": "desktop/e2e/artifacts/gibson-agent-cdna-into-vector/workspace/pUC19_synthetic_ORF.gb",
            "path": "result[*].id"
          }
        }
      ],
      "screenshot": true
    },
    {
      "select_feature": {
        "label": "synthetic ORF"
      }
    },
    {
      "select_tab": "sequence"
    },
    {
      "expect": [
        {
          "state": "selection.sequence.translations[?(@.feature_id=='feature-0009')].protein",
          "single": true,
          "equals_cli": {
            "command": "translate",
            "file": "desktop/e2e/artifacts/gibson-agent-cdna-into-vector/workspace/pUC19_synthetic_ORF.gb",
            "args": [
              "--feature",
              "feature-0009"
            ],
            "path": "result.protein"
          },
          "message": "the cloned ORF still translates"
        }
      ]
    }
  ]
}
