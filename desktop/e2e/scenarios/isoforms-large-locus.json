{
  "$schema": "../scenario.schema.json",
  "id": "isoforms-large-locus",
  "description": "A 1.2 Mb gene locus (generated by global setup) opens in the desktop app: every feature is drawn on the map, isoforms start with introns compressed and match `dnagent isoforms`, ORF and frame controls are off, and the Sequence view shows only a window, around an exon marked in the Isoforms tab",
  "fixture": "fixtures/formats/locus/synthetic_locus.locus.json",
  "steps": [
    {
      "set_viewport": {
        "width": 1280,
        "height": 800
      }
    },
    {
      "open": {
        "file": "desktop/e2e/artifacts/synthetic_large.locus.json"
      },
      "screenshot": true
    },
    {
      "expect": [
        {
          "state": "document.length",
          "equals_cli": {
            "command": "inspect",
            "file": "desktop/e2e/artifacts/synthetic_large.locus.json",
            "one": "result.length"
          }
        },
        {
          "state": "map.drawn_ids",
          "equals_cli": {
            "command": "features",
            "file": "desktop/e2e/artifacts/synthetic_large.locus.json",
            "path": "result[*].id"
          },
          "message": "every feature drawn at 1.2 Mb"
        },
        {
          "state": "layout.orf_controls_enabled",
          "equals": false
        },
        {
          "state": "isoforms.tab_shown",
          "equals": true
        }
      ]
    },
    {
      "select_tab": "isoforms",
      "screenshot": true
    },
    {
      "expect": [
        {
          "state": "isoforms.compress",
          "equals": true,
          "message": "large loci start with introns compressed"
        },
        {
          "state": "isoforms.rows[*].transcript",
          "equals_cli": {
            "command": "isoforms",
            "file": "desktop/e2e/artifacts/synthetic_large.locus.json",
            "path": "result.isoforms[*].transcript_id"
          }
        },
        {
          "state": "isoforms.drawn_ids",
          "equals_cli": {
            "command": "isoforms",
            "file": "desktop/e2e/artifacts/synthetic_large.locus.json",
            "path": "result.isoforms[*].transcript_id"
          }
        },
        {
          "state": "isoforms.rows[*].exons",
          "equals_cli": {
            "command": "isoforms",
            "file": "desktop/e2e/artifacts/synthetic_large.locus.json",
            "path": "result.isoforms[*].exons",
            "transform": "spans"
          }
        },
        {
          "state": "isoforms.rows[*].codons",
          "equals_cli": {
            "command": "isoforms",
            "file": "desktop/e2e/artifacts/synthetic_large.locus.json",
            "path": "result",
            "transform": "codon_marks"
          }
        }
      ]
    },
    {
      "select_tab": "sequence"
    },
    {
      "expect": [
        {
          "state": "layout.sequence_rendered",
          "equals": null,
          "message": "nothing selected: no bases rendered, a notice instead"
        }
      ]
    },
    {
      "select_tab": "isoforms"
    },
    {
      "double_click_exon": {
        "transcript": "SYNT0001.1",
        "exon": 3
      }
    },
    {
      "expect": [
        {
          "state": "selection.range",
          "equals_cli": {
            "command": "isoforms",
            "file": "desktop/e2e/artifacts/synthetic_large.locus.json",
            "one": "result.isoforms[?(@.transcript_id=='SYNT0001.1')].exons[3]",
            "transform": "spans"
          }
        }
      ]
    },
    {
      "click": {
        "testid": "isoform-show-sequence"
      },
      "screenshot": true
    },
    {
      "expect": [
        {
          "state": "active_tab",
          "equals": "sequence"
        },
        {
          "state": "layout.sequence_shows_range",
          "equals": true,
          "message": "the window covers the marked exon"
        },
        {
          "state": "selection.range",
          "equals_cli": {
            "command": "isoforms",
            "file": "desktop/e2e/artifacts/synthetic_large.locus.json",
            "one": "result.isoforms[?(@.transcript_id=='SYNT0001.1')].exons[3]",
            "transform": "spans"
          }
        }
      ]
    },
    {
      "select_tab": "isoforms"
    },
    {
      "export_svg": {
        "view": "isoforms",
        "path": "desktop/e2e/artifacts/isoforms-large-locus/synbig.isoforms.svg"
      }
    }
  ]
}
