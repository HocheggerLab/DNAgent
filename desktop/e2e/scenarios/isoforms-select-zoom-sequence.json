{
  "$schema": "../scenario.schema.json",
  "id": "isoforms-select-zoom-sequence",
  "description": "Clicking an isoform selects its mRNA, highlights its exons and shows its expression across the cell lines (from `dnagent isoforms`); dragging across its last exon or double-clicking an exon marks exactly that exon, which Show in Sequence opens, showing only that transcript's own annotation rows; both views export standalone SVG",
  "fixture": "fixtures/formats/locus/synthetic_locus.locus.json",
  "steps": [
    {
      "set_viewport": {
        "width": 1280,
        "height": 800
      }
    },
    {
      "open": {}
    },
    {
      "select_tab": "isoforms"
    },
    {
      "expect": [
        {
          "state": "isoforms.buttons",
          "equals": {
            "zoom_selection": false,
            "show_sequence": false
          }
        },
        {
          "state": "isoforms.detail",
          "equals": null
        }
      ]
    },
    {
      "select_isoform": {
        "transcript": "SYNT0001.1"
      },
      "screenshot": true
    },
    {
      "click": {
        "testid": "isoform-show-sequence"
      },
      "note": "the selected transcript, in the Sequence view"
    },
    {
      "expect": [
        {
          "state": "layout.sequence_feature_ids",
          "equals_cli": {
            "command": "isoforms",
            "path": "result",
            "transform": {
              "name": "transcript_feature_ids",
              "transcript": "SYNT0001.1"
            }
          },
          "message": "with an isoform selected the Sequence view draws only its own mRNA and CDS, not every transcript"
        }
      ]
    },
    {
      "select_tab": "isoforms"
    },
    {
      "expect": [
        {
          "state": "selection.feature_id",
          "equals_cli": {
            "command": "isoforms",
            "one": "result.isoforms[?(@.transcript_id=='SYNT0001.1')].mrna_feature_id"
          },
          "message": "the isoform's mRNA feature is selected"
        },
        {
          "state": "isoforms.rows[?(@.selected==true)].transcript",
          "equals_cli": {
            "command": "isoforms",
            "path": "result.isoforms[?(@.transcript_id=='SYNT0001.1')].transcript_id"
          }
        },
        {
          "state": "isoforms.highlighted_exons",
          "equals_cli": {
            "command": "isoforms",
            "one": "result.isoforms[?(@.transcript_id=='SYNT0001.1')].exons",
            "transform": "spans"
          },
          "message": "the selected transcript's exons are highlighted across rows"
        },
        {
          "state": "isoforms.detail.transcript",
          "equals_cli": {
            "command": "isoforms",
            "one": "result.isoforms[?(@.transcript_id=='SYNT0001.1')].transcript_id"
          }
        },
        {
          "state": "isoforms.detail.display",
          "equals_cli": {
            "command": "isoforms",
            "one": "result.isoforms[?(@.transcript_id=='SYNT0001.1')].expression[?(@.quantifier=='bambu_lr')].display"
          }
        },
        {
          "state": "isoforms.detail.cells",
          "equals_cli": {
            "command": "isoforms",
            "one": "result",
            "transform": {
              "name": "cell_means",
              "transcript": "SYNT0001.1"
            }
          },
          "message": "one bar per panel cell line, CLI means"
        }
      ]
    },
    {
      "drag_exons": {
        "transcript": "SYNT0001.1",
        "from": 3,
        "to": 3
      },
      "screenshot": true
    },
    {
      "expect": [
        {
          "state": "selection.range",
          "equals_cli": {
            "command": "isoforms",
            "one": "result.isoforms[?(@.transcript_id=='SYNT0001.1')].exons[3]",
            "transform": "spans"
          },
          "message": "the drag marks exactly the last exon"
        },
        {
          "state": "isoforms.range",
          "equals_state": "selection.range"
        },
        {
          "state": "isoforms.detail",
          "equals": null,
          "message": "a range replaces the isoform selection"
        },
        {
          "state": "isoforms.buttons",
          "equals": {
            "zoom_selection": true,
            "show_sequence": true
          }
        }
      ]
    },
    {
      "click": {
        "testid": "isoform-zoom-selection"
      },
      "screenshot": true
    },
    {
      "expect": [
        {
          "state": "selection.range",
          "equals_cli": {
            "command": "isoforms",
            "one": "result.isoforms[?(@.transcript_id=='SYNT0001.1')].exons[3]",
            "transform": "spans"
          },
          "message": "zoom keeps the selection"
        },
        {
          "state": "isoforms.range",
          "equals_state": "selection.range"
        }
      ]
    },
    {
      "click": {
        "testid": "isoform-show-sequence"
      },
      "screenshot": true
    },
    {
      "expect": [
        {
          "state": "active_tab",
          "equals": "sequence"
        },
        {
          "state": "selection.range",
          "equals_cli": {
            "command": "isoforms",
            "one": "result.isoforms[?(@.transcript_id=='SYNT0001.1')].exons[3]",
            "transform": "spans"
          },
          "message": "the Sequence tab shows the marked exon"
        }
      ]
    },
    {
      "select_tab": "isoforms"
    },
    {
      "click": {
        "testid": "isoform-zoom-fit"
      }
    },
    {
      "double_click_exon": {
        "transcript": "SYNT0002.1",
        "exon": 3
      }
    },
    {
      "expect": [
        {
          "state": "selection.range",
          "equals_cli": {
            "command": "isoforms",
            "one": "result.isoforms[?(@.transcript_id=='SYNT0002.1')].exons[3]",
            "transform": "spans"
          },
          "message": "double-click marks the whole exon (the alternative last exon)"
        }
      ]
    },
    {
      "export_svg": {
        "view": "isoforms",
        "path": "desktop/e2e/artifacts/isoforms-select-zoom-sequence/synloc.isoforms.svg"
      }
    },
    {
      "select_tab": "map"
    },
    {
      "export_svg": {
        "view": "map",
        "path": "desktop/e2e/artifacts/isoforms-select-zoom-sequence/synloc.map.svg"
      }
    }
  ]
}
