{
  "$schema": "../scenario.schema.json",
  "id": "list-selection-links-views",
  "description": "Selecting from the feature list highlights the engine location in Map and Sequence",
  "fixture": "fixtures/formats/snapgene/synthetic_linear.dna",
  "steps": [
    {
      "open": {}
    },
    {
      "click": {
        "testid": "feature-item",
        "index": 0
      },
      "note": "real pointer click on the first list item",
      "screenshot": true
    },
    {
      "expect": [
        {
          "state": "selection.feature_id",
          "equals_cli": {
            "command": "features",
            "one": "result[?(@.label=='reverse multipart')].id"
          }
        },
        {
          "state": "features[?(@.selected==true)].id",
          "equals_cli": {
            "command": "features",
            "path": "result[?(@.label=='reverse multipart')].id"
          },
          "message": "exactly the selected item is pressed"
        },
        {
          "state": "selection.map.parts",
          "equals_cli": {
            "command": "features",
            "one": "result[?(@.label=='reverse multipart')].location",
            "transform": "parts"
          },
          "message": "every source part highlighted, in source order"
        },
        {
          "state": "selection.map.active_labels",
          "equals_cli": {
            "command": "features",
            "path": "result[?(@.label=='reverse multipart')].label"
          }
        },
        {
          "state": "selection.sequence",
          "equals": null,
          "message": "hidden view reports nothing"
        }
      ]
    },
    {
      "select_tab": "sequence",
      "screenshot": true
    },
    {
      "expect": [
        {
          "state": "active_tab",
          "equals": "sequence"
        },
        {
          "state": "selection.feature_id",
          "equals_cli": {
            "command": "features",
            "one": "result[?(@.label=='reverse multipart')].id"
          },
          "message": "selection survives the tab switch"
        },
        {
          "state": "selection.sequence.parts",
          "equals_cli": {
            "command": "features",
            "one": "result[?(@.label=='reverse multipart')].location",
            "transform": "parts"
          },
          "message": "track spans rebuild each source part, in source order"
        },
        {
          "state": "selection.sequence.highlighted_positions",
          "equals_cli": {
            "command": "features",
            "one": "result[?(@.label=='reverse multipart')].location",
            "transform": "positions"
          }
        },
        {
          "state": "selection.sequence.complement_highlighted_positions",
          "equals_state": "selection.sequence.highlighted_positions"
        },
        {
          "state": "selection.map",
          "equals": null
        }
      ]
    },
    {
      "select_tab": "map"
    },
    {
      "expect": [
        {
          "state": "active_tab",
          "equals": "map"
        },
        {
          "state": "selection.feature_id",
          "equals_cli": {
            "command": "features",
            "one": "result[?(@.label=='reverse multipart')].id"
          }
        },
        {
          "state": "features[?(@.selected==true)].id",
          "equals_cli": {
            "command": "features",
            "path": "result[?(@.label=='reverse multipart')].id"
          },
          "message": "exactly the selected item is pressed"
        },
        {
          "state": "selection.map.parts",
          "equals_cli": {
            "command": "features",
            "one": "result[?(@.label=='reverse multipart')].location",
            "transform": "parts"
          },
          "message": "every source part highlighted, in source order"
        },
        {
          "state": "selection.map.active_labels",
          "equals_cli": {
            "command": "features",
            "path": "result[?(@.label=='reverse multipart')].label"
          }
        },
        {
          "state": "selection.sequence",
          "equals": null,
          "message": "hidden view reports nothing"
        }
      ]
    }
  ]
}
