{
  "$schema": "../scenario.schema.json",
  "id": "undo-redo-delete",
  "description": "Added features can be undone, redone and deleted with buttons and shortcuts; imported features stay read-only",
  "fixture": "fixtures/formats/snapgene/synthetic_translation.dna",
  "steps": [
    {
      "set_viewport": {
        "width": 1440,
        "height": 900
      }
    },
    {
      "open": {}
    },
    {
      "select_feature": {
        "label": "forward CDS"
      }
    },
    {
      "select_feature": {
        "label": "reverse split CDS",
        "extend": true
      }
    },
    {
      "click": {
        "testid": "new-feature"
      }
    },
    {
      "fill": {
        "testid": "feature-label",
        "value": "temporary"
      }
    },
    {
      "click": {
        "testid": "feature-add"
      }
    },
    {
      "expect": [
        {
          "state": "edit.revision",
          "equals": 1
        },
        {
          "state": "edit.shown.undo",
          "equals": true
        },
        {
          "state": "edit.shown.delete_feature",
          "equals": true
        },
        {
          "state": "features[?(@.added==true)].id",
          "equals_state": "edit.added_feature_ids"
        }
      ]
    },
    {
      "press": "Meta+z",
      "note": "undo shortcut"
    },
    {
      "expect": [
        {
          "state": "edit.revision",
          "equals": 0
        },
        {
          "state": "edit.dirty",
          "equals": false
        },
        {
          "state": "edit.shown.redo",
          "equals": true
        },
        {
          "state": "features[*].id",
          "equals_cli": {
            "command": "features",
            "path": "result[*].id"
          },
          "message": "undo restores the imported feature list"
        }
      ]
    },
    {
      "press": "Meta+Shift+z",
      "note": "redo shortcut"
    },
    {
      "expect": [
        {
          "state": "edit.revision",
          "equals": 1
        },
        {
          "state": "edit.added_feature_ids",
          "equals": [
            "feature-0008"
          ]
        }
      ]
    },
    {
      "select_feature": {
        "id": "feature-0008"
      }
    },
    {
      "click": {
        "testid": "delete-feature"
      },
      "note": "asks first"
    },
    {
      "expect": [
        {
          "state": "confirm.open",
          "equals": true
        },
        {
          "state": "edit.revision",
          "equals": 1
        }
      ]
    },
    {
      "click": {
        "testid": "confirm-ok"
      }
    },
    {
      "expect": [
        {
          "state": "edit.revision",
          "equals": 2
        },
        {
          "state": "edit.can_redo",
          "equals": false
        },
        {
          "state": "features[*].id",
          "equals_cli": {
            "command": "features",
            "path": "result[*].id"
          },
          "message": "deleting returns to the imported features"
        }
      ]
    },
    {
      "click": {
        "testid": "undo"
      }
    },
    {
      "expect": [
        {
          "state": "edit.revision",
          "equals": 1
        },
        {
          "state": "edit.added_feature_ids",
          "equals": [
            "feature-0008"
          ]
        }
      ]
    },
    {
      "select_feature": {
        "label": "forward CDS"
      }
    },
    {
      "expect": [
        {
          "state": "edit.shown.delete_feature",
          "equals": true,
          "message": "imported features can be deleted too"
        }
      ]
    },
    {
      "press": "Backspace",
      "note": "the keyboard asks first"
    },
    {
      "expect": [
        {
          "state": "confirm.open",
          "equals": true
        },
        {
          "state": "edit.revision",
          "equals": 1,
          "message": "nothing is deleted before the answer"
        }
      ],
      "screenshot": true
    },
    {
      "click": {
        "testid": "confirm-cancel"
      }
    },
    {
      "expect": [
        {
          "state": "confirm.open",
          "equals": false
        },
        {
          "state": "edit.revision",
          "equals": 1,
          "message": "Cancel keeps the feature"
        }
      ]
    }
  ]
}
