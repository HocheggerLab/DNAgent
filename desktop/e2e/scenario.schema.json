{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dnagent.local/desktop/e2e/scenario.schema.json",
  "title": "DNAgent desktop e2e scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "description",
    "fixture",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "$ref": "#/definitions/fixture"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "definitions": {
    "fixture": {
      "type": "string",
      "pattern": "^fixtures/formats/[a-z]+/[A-Za-z0-9_]+(\\.(dna|fasta|gb)|\\.locus\\.json)$",
      "description": "Repository-relative public fixture path (.dna, .fasta, .gb or a .locus.json gene locus bundle)."
    },
    "state_path": {
      "type": "string",
      "minLength": 1,
      "description": "Path into getState() (JSON path subset, see e2e/README.md)."
    },
    "transform": {
      "oneOf": [
        {
          "enum": [
            "parts",
            "positions",
            "count",
            "codes",
            "codon_middles",
            "orf_regions",
            "orf_parts",
            "orf_positions",
            "lengths",
            "site_ticks",
            "site_labels",
            "site_regions",
            "site_cuts",
            "recognition_range",
            "fragment_parts",
            "site_enzymes",
            "detection_rows",
            "default_detections",
            "detection_spans_new",
            "spans",
            "isoform_displays",
            "codon_marks"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "base"
          ],
          "properties": {
            "name": {
              "const": "ids_covering"
            },
            "base": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "from",
            "to"
          ],
          "properties": {
            "name": {
              "const": "forward_span"
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "as": {
              "enum": [
                "range",
                "parts"
              ]
            }
          },
          "description": "Shift-click rule over CLI features (labels): forward from `from`'s first part start to the furthest part end of both, wrapping on circular molecules."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "set"
          ],
          "properties": {
            "name": {
              "const": "enzyme_set"
            },
            "set": {
              "enum": [
                "unique6",
                "unique_dual6",
                "unique_any"
              ]
            }
          },
          "description": "From a `sites` result for every catalogue enzyme: the enzymes of a display set (documented in docs/restriction.md), alphabetical."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "rank"
          ],
          "properties": {
            "name": {
              "const": "fragment_range"
            },
            "rank": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "From a `digest` result: the half-open range of the fragment at this rank (longest first, then by start), as the digest list orders them."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "label"
          ],
          "properties": {
            "name": {
              "const": "detection_range"
            },
            "label": {
              "type": "string"
            }
          },
          "description": "From detect-features matches: the selection range of the first match with this name."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "transcript"
          ],
          "properties": {
            "name": {
              "const": "cell_means"
            },
            "transcript": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "From an `isoforms` result: [{cell_line, mean}] for one transcript under the result's quantifier, every panel cell line first (mean null where the quantifier has no value)."
        }
      ]
    },
    "cli_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "one"
          ]
        }
      ],
      "properties": {
        "command": {
          "enum": [
            "inspect",
            "features",
            "primers",
            "translate",
            "orfs",
            "sites",
            "digest",
            "enzymes",
            "detect-features",
            "isoforms"
          ]
        },
        "fixture": {
          "$ref": "#/definitions/fixture"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Array for wildcard/filter paths, else the single value."
        },
        "one": {
          "type": "string",
          "minLength": 1,
          "description": "Must match exactly one value."
        },
        "transform": {
          "$ref": "#/definitions/transform"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "Pick one element of the resolved array."
        },
        "args": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "memory"
                ],
                "properties": {
                  "memory": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "description": "A remembered value; arrays are joined with commas (e.g. enzyme names for --enzymes)."
              }
            ]
          },
          "description": "Extra CLI arguments after the fixture, e.g. [\"--feature\", \"feature-0001\"] or [\"--enzymes\", {\"memory\": \"shown\"}]."
        },
        "saved": {
          "type": "boolean",
          "description": "Run against the file most recently written by a save_as step."
        },
        "file": {
          "type": "string",
          "pattern": "^desktop/e2e/artifacts/[A-Za-z0-9_./-]+$",
          "description": "Run against this file (under desktop/e2e/artifacts), e.g. a handoff snapshot or agent product."
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "oneOf": [
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "equals_cli"
          ]
        },
        {
          "required": [
            "equals_state"
          ]
        },
        {
          "required": [
            "equals_memory"
          ]
        },
        {
          "required": [
            "equals_json_file"
          ]
        }
      ],
      "properties": {
        "state": {
          "$ref": "#/definitions/state_path"
        },
        "equals": {
          "description": "Literal; rejected on biological state paths."
        },
        "equals_cli": {
          "$ref": "#/definitions/cli_expectation"
        },
        "equals_state": {
          "$ref": "#/definitions/state_path"
        },
        "message": {
          "type": "string"
        },
        "single": {
          "type": "boolean",
          "description": "The state path must match exactly one value, compared unwrapped."
        },
        "equals_memory": {
          "type": "string",
          "description": "A value stored by an earlier remember step."
        },
        "equals_json_file": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "oneOf": [
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "one"
              ]
            }
          ],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^desktop/e2e/artifacts/[A-Za-z0-9_./-]+$"
            },
            "path": {
              "type": "string"
            },
            "one": {
              "type": "string"
            }
          },
          "description": "A value from a JSON file the app wrote (e.g. handoff/context.json)."
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open"
          ],
          "properties": {
            "open": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fixture": {
                  "$ref": "#/definitions/fixture"
                },
                "delay_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5000
                },
                "wait": {
                  "type": "boolean",
                  "default": true
                },
                "expect_error": {
                  "type": "boolean",
                  "default": false
                },
                "saved": {
                  "type": "boolean",
                  "description": "Open the file written by the last save_as step."
                },
                "file": {
                  "type": "string",
                  "pattern": "^desktop/e2e/artifacts/[A-Za-z0-9_./-]+$"
                }
              }
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "browse"
          ],
          "properties": {
            "browse": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fixture": {
                  "$ref": "#/definitions/fixture"
                }
              }
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "select_feature"
          ],
          "properties": {
            "select_feature": {
              "type": "object",
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "id"
                  ]
                },
                {
                  "required": [
                    "label"
                  ]
                }
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "description": "Resolved to an id through CLI features; must match exactly one."
                },
                "extend": {
                  "type": "boolean",
                  "description": "Shift-click (extend the selection)."
                }
              }
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "select_tab"
          ],
          "properties": {
            "select_tab": {
              "enum": [
                "map",
                "sequence",
                "isoforms"
              ]
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "click_sequence_base"
          ],
          "properties": {
            "click_sequence_base": {
              "type": "integer",
              "minimum": 0
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "click"
          ],
          "properties": {
            "click": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "testid"
              ],
              "properties": {
                "testid": {
                  "type": "string",
                  "minLength": 1
                },
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                },
                "modifiers": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "Shift",
                      "Alt",
                      "Control",
                      "Meta"
                    ]
                  },
                  "uniqueItems": true
                }
              }
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wait_idle"
          ],
          "properties": {
            "wait_idle": {
              "const": true
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expect"
          ],
          "properties": {
            "expect": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/assertion"
              }
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "set_viewport"
          ],
          "properties": {
            "set_viewport": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 320,
                  "maximum": 3840
                },
                "height": {
                  "type": "integer",
                  "minimum": 240,
                  "maximum": 2160
                }
              }
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "set_color_scheme"
          ],
          "properties": {
            "set_color_scheme": {
              "enum": [
                "light",
                "dark"
              ],
              "description": "Emulated OS appearance (prefers-color-scheme)."
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "select_option"
          ],
          "properties": {
            "select_option": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "testid",
                "value"
              ],
              "properties": {
                "testid": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reload"
          ],
          "properties": {
            "reload": {
              "const": true,
              "description": "Reload the page (local preferences persist; the document does not)."
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "select_orf"
          ],
          "properties": {
            "select_orf": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^orf-[0-9]{4,}$"
                }
              }
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "drag_bases"
          ],
          "properties": {
            "drag_bases": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "integer",
                  "minimum": 0
                },
                "to": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "description": "Real mouse drag across forward-strand bases (Sequence tab)."
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fill"
          ],
          "properties": {
            "fill": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "testid",
                "value"
              ],
              "properties": {
                "testid": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "press"
          ],
          "properties": {
            "press": {
              "type": "string",
              "minLength": 1,
              "description": "Keyboard shortcut, e.g. Meta+z (Playwright key syntax)."
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "save_as"
          ],
          "properties": {
            "save_as": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^desktop/e2e/artifacts/[A-Za-z0-9_./-]+\\.(gb|gbk|genbank|dna)$"
                }
              },
              "description": "Queue the save dialog answer (repo-relative, under desktop/e2e/artifacts) and click Save as…."
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "remember"
          ],
          "properties": {
            "remember": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "as"
              ],
              "properties": {
                "state": {
                  "type": "string"
                },
                "as": {
                  "type": "string",
                  "pattern": "^[a-z_]+$"
                },
                "single": {
                  "type": "boolean"
                }
              }
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "set_workspace"
          ],
          "properties": {
            "set_workspace": {
              "type": "string",
              "pattern": "^desktop/e2e/artifacts/[A-Za-z0-9_./-]+$",
              "description": "Choose this workspace folder through the Workspace… button (created if missing)."
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "poll_workspace"
          ],
          "properties": {
            "poll_workspace": {
              "const": true,
              "description": "Run the app's workspace poll now (the same function its timer runs)."
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_cli"
          ],
          "properties": {
            "run_cli": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "args"
              ],
              "properties": {
                "args": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "description": "Play the agent: run the real dnagent CLI from the repository root; it must succeed."
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "click_site"
          ],
          "properties": {
            "click_site": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enzyme"
              ],
              "properties": {
                "enzyme": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "Click the enzyme's site label (Map tab) or first site track (Sequence tab)."
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "choose_enzymes"
          ],
          "properties": {
            "choose_enzymes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "names"
              ],
              "properties": {
                "names": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "description": "Open Choose…, tick exactly these enzymes and confirm."
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toggle_detection"
          ],
          "properties": {
            "toggle_detection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "Click the tick box of the first Detected row with this name."
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "select_detection"
          ],
          "properties": {
            "select_detection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "Click the first Detected row with this name (selects its span)."
            },
            "screenshot": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "select_isoform"
          ],
          "properties": {
            "select_isoform": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transcript"
              ],
              "properties": {
